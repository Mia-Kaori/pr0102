# Variables de configuración de webmin-install.sh

# IP fija del servidor en la red solo-anfitrión (enp0s8)
SERVER_IP=192.168.0.10

# Puerto en el que escucha Webmin
WEBMIN_PORT=10000

# Contraseña del usuario root de Webmin
WEBMIN_ROOT_PASSWORD=PonTuContrasena123 # añadir contraseña propia 

# Repositorio oficial de Webmin y su clave GPG
WEBMIN_REPO_URL=https://download.webmin.com/download/newkey/repository
WEBMIN_KEY_URL=https://download.webmin.com/developers-key.asc
